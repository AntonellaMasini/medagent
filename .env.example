# Copy this to .env and fill in real values.

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number for WhatsApp; replace with your approved sender for production
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=                  # E.164 Twilio voice number for outbound clinic calls (e.g. +34...)

# --- Google ---
GOOGLE_MAPS_API_KEY=
# Google Calendar OAuth2 (create at https://console.cloud.google.com/apis/credentials)
# Enable "Google Calendar API" and create OAuth 2.0 Client ID (Web application)
# Add redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- ElevenLabs Speech Engine ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=                  # Speech Engine ID (seng_...) — created via scripts/setup_speech_engine.py
ELEVENLABS_PHONE_NUMBER_ID=           # Twilio number registered in ElevenLabs (run setup script)

# --- Anthropic (LLM for voice conversations) ---
ANTHROPIC_API_KEY=

# --- Voice / Demo ---
DEMO_MODE=                            # "true" or unset
DEMO_RECEPTIONIST_NUMBER=             # phone to call in demo mode instead of real clinics

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./medagent.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Public URL where Twilio can reach your webhook (e.g. ngrok URL during dev)
BASE_URL=http://localhost:8000
COOKIES_DIR=./infrastructure/cookies

# --- Cigna ---
CIGNA_LOGIN_URL=https://clientes.cigna.es
CIGNA_DOCTORS_URL=https://clientes.cigna.es/cp/cuadro-medico
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Behavior ---
OTP_WAIT_TIMEOUT_SECONDS=300
CREDENTIALS_TOKEN_TTL_MINUTES=10
LOG_LEVEL=INFO
