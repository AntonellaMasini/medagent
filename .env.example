# Copy this to .env and fill in real values.

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number for WhatsApp; replace with your approved sender for production
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=

# --- Google ---
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- ElevenLabs (v2) ---
ELEVENLABS_API_KEY=

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./medagent.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
# Public URL where Twilio can reach your webhook (e.g. ngrok URL during dev)
BASE_URL=http://localhost:8000
COOKIES_DIR=./infrastructure/cookies

# --- Cigna ---
CIGNA_LOGIN_URL=https://clientes.cigna.es
CIGNA_DOCTORS_URL=https://clientes.cigna.es/cp/cuadro-medico
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# --- Behavior ---
OTP_WAIT_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
